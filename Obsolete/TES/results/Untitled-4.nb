           RowBox[{"AppendTo", "[", 
            RowBox[{"\[Eta]tdata", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"pdata", "[", 
                 RowBox[{"[", 
                  RowBox[{"ind", "-", "1"}], "]"}], "]"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{
                RowBox[{"pdata", "[", 
                 RowBox[{"[", "ind", "]"}], "]"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], ";", 
