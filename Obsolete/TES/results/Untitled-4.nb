    RowBox[{"v1_", ",", "v2_", ",", "dv_"}], "]"}], "[", "d_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "pdata", ",", "ele1", ",", "\[Eta]tdata", ",", "vmlis", ",", "ind"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"vmlis", "=", 
      RowBox[{"Drop", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{"vm", ",", 
          RowBox[{"{", 
           RowBox[{"vm", ",", "v1", ",", "v2", ",", "dv"}], "}"}]}], "]"}], ",",
         "d"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pdata", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"vmlis", ",", "etalis"}], "}"}], "]"}]}], ";", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"ele1", "=", 
      RowBox[{"pdata", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ind", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Eta]tdata", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"ind", "<=", 
        RowBox[{"Length", "[", "pdata", "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"pdata", "[", 
             RowBox[{"[", "ind", "]"}], "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], "==", "ele1"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ele1", "=", 
            RowBox[{
             RowBox[{"pdata", "[", 
              RowBox[{"[", "ind", "]"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ";", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"\[Eta]tdata", ",", 
             RowBox[{"pdata", "[", 
              RowBox[{"[", "ind", "]"}], "]"}]}], "]"}]}], ",", 
