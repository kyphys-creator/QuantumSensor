Cell[TextData[{"\:25a0 CRTiN, CRTiNLeft, CRTiNRight   \:2014 vm \:306e\:9023\:7d9a\:95a2\:6570\:7248\:5fdc\:7b54\:30ab\:30fc\:30cd\:30eb\n\nCRvmTiN* \:3068\:540c\:3058 w \:7a4d\:5206\:3092\:884c\:3046\:304c\:3001vm \:3092 ?NumericQ \:30d1\:30bf\:30fc\:30f3\:3067\:53d7\:3051\:53d6\:308a\:3001\:30b5\:30f3\:30d7\:30ea\:30f3\:30b0\:305b\:305a\:306b\:9023\:7d9a\:5024\:3092\:8fd4\:3059\:3002\n\n\:7528\:9014: vm \:7a4d\:5206\:3092 NIntegrate \:3067\:884c\:3044\:305f\:3044\:3068\:304d\:3001\:307e\:305f\:306f \:03b7(vm) \:3092 \:7573\:307f\:8fbc\:3080\:3068\:304d\:306b\:9023\:7d9a\:5024\:304c\:5fc5\:8981\:306a\:30b1\:30fc\:30b9\:3002\n\n\:5b9a\:7fa9:\n  CRTiN[md, n][E1, E2][vm] = \:222b_E1^E2 (KerRTiNl[md][n][w, MKIDsig\:00b7w][vm\:00b7kps] + KerRTiNr[\:2026]) dw\n  CRTiNLeft  = KerRTiNl \:306e\:307f\n  CRTiNRight = KerRTiNr \:306e\:307f\n\n\:5f15\:6570\:306e vm \:306f km/s \:5358\:4f4d\:306e\:6570\:5024 (\:5185\:90e8\:3067 vm\:00b7kps \:306b\:5909\:63db)\:3002"}], "Text",
 Background->RGBColor[0.95, 0.97, 1.],
 CellTags->"doc",
 ExpressionUUID->"79eb65e4-dbea-4407-a1d5-683c54cec66d"],

Cell["(* Continuous-vm versions of CRvmTiN* *)
(* vm \:3092\:30b5\:30f3\:30d7\:30ea\:30f3\:30b0\:305b\:305a\:3001numeric \:306a vm \:5024\:3067\:306e w \:7a4d\:5206\:3092\:8fd4\:3059\:3002 *)
CRTiN[md_, n_][E1_, E2_][vm_?NumericQ] := Total[Table[
  0.01 eV * (
    KerRTiNl[md][n][w, MKIDsig*w][vm*kps] +
    KerRTiNr[md][n][w, MKIDsig*w][vm*kps]
  ),
  {w, E1, E2, 0.01}
]];

CRTiNLeft[md_, n_][E1_, E2_][vm_?NumericQ] := Total[Table[
  0.01 eV * KerRTiNl[md][n][w, MKIDsig*w][vm*kps],
  {w, E1, E2, 0.01}
]];

CRTiNRight[md_, n_][E1_, E2_][vm_?NumericQ] := Total[Table[
  0.01 eV * KerRTiNr[md][n][w, MKIDsig*w][vm*kps],
  {w, E1, E2, 0.01}
]];", "Input",
 InitializationCell->True,
 Background->RGBColor[0.98, 0.95, 0.95],
 ExpressionUUID->"b537690d-1996-4394-84a0-2d50e278596d"], (* QSENS-CONT-KERNELS-v1 *)

Cell[TextData[{"\:25a0 CRintTiN, CRintTiNLeft, CRintTiNRight, CRintTiNWeighted   \:2014 vm \:65b9\:5411\:7a4d\:5206 (midpoint rule)\n\n\:5b9a\:7fa9:\n  CRintTiN[md, n][E1, E2][vmin, vmax, nsamples]\n    = \:222b_vmin^vmax CRTiN[md, n][E1, E2][vm] dvm\n    \:2248 dvm \:00d7 \:03a3_{i=1..nsamples} CRTiN[md, n][E1, E2][vm_i]\n    \:3053\:3053\:3067 vm_i = vmin + (i - 0.5) \:00b7 dvm,  dvm = (vmax - vmin) / nsamples\n\n\:5f15\:6570:\n  \:2022 md           DM \:8cea\:91cf\n  \:2022 n            \:5a92\:4ecb\:5b50\:30e2\:30c7\:30eb (1/2/3)\n  \:2022 E1, E2       \:89b3\:6e2c\:30a8\:30cd\:30eb\:30ae\:30fc bin (eV)\n  \:2022 vmin, vmax   vm \:7a4d\:5206\:7bc4\:56f2 (km/s, \:6570\:5024)\n  \:2022 nsamples     \:30b5\:30f3\:30d7\:30ea\:30f3\:30b0\:70b9\:6570 (\:6574\:6570)\n\n\:7a2e\:985e:\n  \:2022 CRintTiN        \:4e21\:30d6\:30e9\:30f3\:30c1\:548c\:306e vm \:7a4d\:5206\n  \:2022 CRintTiNLeft    \:5de6\:30d6\:30e9\:30f3\:30c1\:306e\:307f\n  \:2022 CRintTiNRight   \:53f3\:30d6\:30e9\:30f3\:30c1\:306e\:307f\n  \:2022 CRintTiNWeighted   etaFunc[vm] \:3092\:639b\:3051\:3066\:7a4d\:5206 (\:30cf\:30ed\:901f\:5ea6\:5206\:5e03 \:03b7(vm) \:7528)\n\n\:4f8b:\n  result = CRintTiN[100 MeV, 1][1.0, 1.5][5, 200, 100]\n  result = CRintTiNWeighted[100 MeV, 1][1.0, 1.5][5, 200, 100, etaSHM]"}], "Text",
 Background->RGBColor[0.95, 0.98, 0.95],
 CellTags->"doc",
 ExpressionUUID->"b015d182-8fba-4054-9f6b-74ed3688ce3d"],

Cell["(* Velocity-integrated versions of CRTiN* *)
(* Midpoint rule: nsamples \:306e\:70b9\:3092 [vmin, vmax] \:306e\:4e2d\:70b9\:3067\:30b5\:30f3\:30d7\:30ea\:30f3\:30b0\:3001dvm = (vmax-vmin)/nsamples \:3092\:639b\:3051\:3066\:548c\:3092\:53d6\:308b\:3002 *)
CRintTiN[md_, n_][E1_, E2_][vmin_?NumericQ, vmax_?NumericQ, nsamples_Integer] := Module[
  {dvm, vmList},
  dvm = (vmax - vmin) / nsamples;
  vmList = Table[vmin + (i - 0.5) dvm, {i, 1, nsamples}];
  Total[CRTiN[md, n][E1, E2][#] & /@ vmList] * dvm
];

CRintTiNLeft[md_, n_][E1_, E2_][vmin_?NumericQ, vmax_?NumericQ, nsamples_Integer] := Module[
  {dvm, vmList},
  dvm = (vmax - vmin) / nsamples;
  vmList = Table[vmin + (i - 0.5) dvm, {i, 1, nsamples}];
  Total[CRTiNLeft[md, n][E1, E2][#] & /@ vmList] * dvm
];

CRintTiNRight[md_, n_][E1_, E2_][vmin_?NumericQ, vmax_?NumericQ, nsamples_Integer] := Module[
  {dvm, vmList},
  dvm = (vmax - vmin) / nsamples;
  vmList = Table[vmin + (i - 0.5) dvm, {i, 1, nsamples}];
  Total[CRTiNRight[md, n][E1, E2][#] & /@ vmList] * dvm
];

(* Halo-weighted version *)
CRintTiNWeighted[md_, n_][E1_, E2_][vmin_?NumericQ, vmax_?NumericQ, nsamples_Integer, etaFunc_] := Module[
  {dvm, vmList},
  dvm = (vmax - vmin) / nsamples;
  vmList = Table[vmin + (i - 0.5) dvm, {i, 1, nsamples}];
  Total[(CRTiN[md, n][E1, E2][#] * etaFunc[#]) & /@ vmList] * dvm
];", "Input",
 InitializationCell->True,
 Background->RGBColor[0.95, 0.98, 0.95],
 ExpressionUUID->"43d0d3e2-9c3c-4052-879f-309af7ad1640"], (* QSENS-VEL-INT-v1 *)

}, Open  ]],
