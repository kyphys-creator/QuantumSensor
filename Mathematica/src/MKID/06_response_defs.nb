     RowBox[{"vm", "=", "6"}], ";", "\n", 
     RowBox[{"i", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Rlist", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", "800"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"vm", "<=", "200"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"tab", "=", 
         RowBox[{"Total", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{".01", "eV", "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"KerRTiNr", "[", "md", "]"}], "[", "n", "]"}], "[", 
                RowBox[{"w", ",", 
                 RowBox[{"MKIDsig", "*", "w"}]}], "]"}], "[", 
               RowBox[{"vm", " ", "kps"}], "]"}], ")"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"w", ",", "E1", ",", "E2", ",", ".01"}], "}"}]}], "]"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Rlist", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "=", "tab"}], ";", "\n", 
        RowBox[{"i", " ", "=", " ", 
         RowBox[{"i", "+", "1"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"vm", "=", 
         RowBox[{"vm", "+", 
          FractionBox["195", "800"]}]}], ";"}]}], "\[IndentingNewLine]", 
      "]"}], ";", "\[IndentingNewLine]", "Rlist"}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Code",
 CellChangeTimes->{
  3.971956412103292*^9, 3.971960625931073*^9, {3.978438163254572*^9, 
   3.978438192252157*^9}, {3.978438259530551*^9, 3.978438278046936*^9}, {
   3.978439036581199*^9, 3.978439041189925*^9}, {3.978439072914452*^9, 
   3.978439073071751*^9}, {3.978439232604573*^9, 3.978439264952424*^9}, {
   3.978439605253046*^9, 3.978439630562713*^9}, {3.97969002528399*^9, 
   3.979690068833928*^9}, {3.9796921656981683`*^9, 3.979692219726543*^9}, {
   3.979692250929779*^9, 3.979692253540092*^9}, {3.979700558863533*^9, 
   3.979700565214303*^9}, {3.9797008090479593`*^9, 3.979700819727191*^9}, {
