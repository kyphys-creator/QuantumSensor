Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"RangeAlGen", "[", "vmin_", "]"}], "[", "md_", "]"}], "[", 
     "Ep_", "]"}], "[", "Sig_", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"emax", ",", "emin"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"emax", "=", 
       RowBox[{"Min", "[", 
        RowBox[{
         RowBox[{
          FractionBox["1", "2"], "md", " ", 
          SuperscriptBox["vmin", "2"]}], ",", 
         RowBox[{"Ep", "+", "Sig"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"emin", "=", 
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{"0.1", "eV"}], ",", 
         RowBox[{"Ep", "-", "Sig"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"emin", "<", "emax"}], ")"}], ",", 
        RowBox[{"{", 
         RowBox[{"emin", ",", "emax"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
