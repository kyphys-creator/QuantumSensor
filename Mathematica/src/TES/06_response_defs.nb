 "\:5f0f:\n",
 "    emin = max(0.1 eV, Ep \[Minus] Sig)\n",
 "    emax = min(\.bd\[CenterDot]md\[CenterDot]vmin\.b2, Ep + Sig)\n\n",
 "emin \[GreaterEqual] emax (\:7a4d\:5206\:57df\:304c\:7a7a) \:306e\:5834\
\:5408\:306f ",
 StyleBox["{0, 0}", "Code"],
 " \:3092\:8fd4\:3059\:3002",
