Cell[BoxData[
 RowBox[{
  RowBox[{"IntplArray", "[", "m_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"len", ",", "intpl", ",", "lv"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"len", "=", 
      RowBox[{"Length", "[", "m", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"intpl", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", 
        RowBox[{"len", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"lv", "=", "1"}], ",", 
       RowBox[{"lv", "<=", 
        RowBox[{"len", "-", "1"}]}], ",", 
       RowBox[{"lv", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"intpl", "[", 
          RowBox[{"[", "lv", "]"}], "]"}], "=", 
         RowBox[{"LIntpl1D", "[", 
          RowBox[{
           RowBox[{"m", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"m", "[", 
            RowBox[{"[", 
             RowBox[{"lv", "+", "1"}], "]"}], "]"}]}], "]"}]}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "intpl"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Code",
 CellChangeTimes->{{3.95187728451882*^9, 3.951877514778082*^9}, {
  3.951877563632204*^9, 3.951877615532787*^9}},
