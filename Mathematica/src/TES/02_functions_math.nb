Cell[BoxData[
 RowBox[{
  RowBox[{"LIntpl1D", "[", 
   RowBox[{"x1_", ",", "y1_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"l1", ",", "Leng", ",", "loopvar"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Leng", "=", 
      RowBox[{"Length", "[", "x1", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"l1", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", "Leng"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"loopvar", "=", "1"}], ",", 
       RowBox[{"loopvar", "<=", "Leng"}], ",", 
       RowBox[{"loopvar", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"l1", "[", 
          RowBox[{"[", "loopvar", "]"}], "]"}], "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x1", "[", 
             RowBox[{"[", "loopvar", "]"}], "]"}], "}"}], ",", 
           RowBox[{"y1", "[", 
            RowBox[{"[", "loopvar", "]"}], "]"}]}], "}"}]}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ListInterpolation", "[", 
      RowBox[{"l1", ",", 
       RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Code",
 CellChangeTimes->{{3.886803241878684*^9, 3.886803332203937*^9}, {
  3.886803375390052*^9, 3.886803477230287*^9}, {3.8868035545360613`*^9, 
