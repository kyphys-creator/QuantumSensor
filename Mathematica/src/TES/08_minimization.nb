0e3ffb4d9110"],

Cell[BoxData[
 RowBox[{
  RowBox[{"etaMinimize", "[", 
   RowBox[{"dRmat_", ",", "Ndata_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "m", ",", "n", ",", "cons1", ",", "cons2", ",", "etamin", ",", 
      "etadat"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"m", ",", "n"}], "}"}], "=", 
      RowBox[{"Dimensions", "[", "dRmat", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"cons1", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"y", "[", 
          RowBox[{"j", " ", "+", " ", "1"}], "]"}], " ", "\[LessEqual]", " ", 
         
         RowBox[{"y", "[", "j", "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "1", ",", " ", 
          RowBox[{"n", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cons2", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"0", "<=", 
         RowBox[{"y", "[", "j", "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "1", ",", " ", "n"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"etamin", "=", 
      RowBox[{"NMinimize", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Sum", "[", 
           RowBox[{
            FractionBox[
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"dRmat", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "j"}], "]"}], "]"}], "*", 
                   RowBox[{"y", "[", "j", "]"}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}], "-", 
                RowBox[{"Ndata", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "^", "2"}], 
             RowBox[{"Ndata", "[", 
              RowBox[{"[", "i", "]"}], "]"}]], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "m"}], "}"}]}], "]"}], ",", "cons1", 
          ",", " ", "cons2"}], "}"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"y", "[", "j", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"Method", "->", "\"\<NonlinearInteriorPoint\>\""}], ",", 
        RowBox[{"PrecisionGoal", "->", "4"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"etadat", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"y", "[", "j", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}], "*", "cm"}], "/.", 
       RowBox[{"Delete", "[", 
        RowBox[{"etamin", ",", "1"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"etadat", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Code",
 CellChangeTimes->{3.9648447906856194`*^9, 3.9648593385679436`*^9},
 CellLabel->
  "In[149]:=",ExpressionUUID->"d10245af-7e40-1c4b-9f20-b90758742233"],

