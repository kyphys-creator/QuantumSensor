Cell["\<\
datStepPlot[eta data][min v, max v, v step][trimmed column #]\
\>", "Text",
 CellChangeTimes->{{3.971820985379741*^9, 
  3.971821040246029*^9}},ExpressionUUID->"7d11f206-2762-1545-b239-\
8cac3a3013c3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"datStepPlot", "[", "etalis_", "]"}], "[", 
    RowBox[{"v1_", ",", "v2_", ",", "dv_"}], "]"}], "[", "d_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "pdata", ",", "ele1", ",", "\[Eta]tdata", ",", "vmlis", ",", "ind"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"vmlis", "=", 
      RowBox[{"Drop", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{"vm", ",", 
          RowBox[{"{", 
           RowBox[{"vm", ",", "v1", ",", "v2", ",", "dv"}], "}"}]}], "]"}], ",",
         "d"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pdata", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"vmlis", ",", "etalis"}], "}"}], "]"}]}], ";", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"ele1", "=", 
      RowBox[{"pdata", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ind", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Eta]tdata", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"ind", "<=", 
        RowBox[{"Length", "[", "pdata", "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"pdata", "[", 
             RowBox[{"[", "ind", "]"}], "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], "==", "ele1"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ele1", "=", 
            RowBox[{
             RowBox[{"pdata", "[", 
              RowBox[{"[", "ind", "]"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ";", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"\[Eta]tdata", ",", 
             RowBox[{"pdata", "[", 
              RowBox[{"[", "ind", "]"}], "]"}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ele1", "=", 
            RowBox[{
             RowBox[{"pdata", "[", 
              RowBox[{"[", "ind", "]"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ";", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"\[Eta]tdata", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"pdata", "[", 
                 RowBox[{"[", 
                  RowBox[{"ind", "-", "1"}], "]"}], "]"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{
                RowBox[{"pdata", "[", 
                 RowBox[{"[", "ind", "]"}], "]"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], ";", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"\[Eta]tdata", ",", 
             RowBox[{"pdata", "[", 
              RowBox[{"[", "ind", "]"}], "]"}]}], "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ind", "=", 
         RowBox[{"ind", "+", "1"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";",
      "\[IndentingNewLine]", "\[Eta]tdata"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Code",
 CellLabel->
  "In[150]:=",ExpressionUUID->"57a43515-773b-8b4a-b038-90050c3fa95f"]
}, Open  ]],

