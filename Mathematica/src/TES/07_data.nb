Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SampleInt", "[", "f_", "]"}], "[", 
   RowBox[{"Ev1_", ",", "dEv_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{"f", "[", "Ev", " ", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"Ev", ",", 
        RowBox[{"Ev1", "+", 
         RowBox[{"m", "*", "dEv"}]}], ",", 
        RowBox[{"Ev1", "+", "dEv", "+", 
         RowBox[{"m", "*", "dEv"}]}]}], "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"m", ",", "0", ",", 
      RowBox[{"n", "-", "1"}], ",", "1"}], "}"}]}], "]"}]}]], "Code",
 CellLabel->
  "In[138]:=",ExpressionUUID->"0cc13b12-036f-3840-80c9-215c09fb1933"],

