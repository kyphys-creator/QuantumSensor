Cell["DropCR0[Data matrix][min v, interval size, # of intervals]", "Text",
 CellChangeTimes->{{3.9718192140412836`*^9, 
  3.971819246727595*^9}},ExpressionUUID->"8a2c8284-fee4-f643-a145-\
e1f113b813da"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DropCR0", "[", "Rmat_", "]"}], "[", 
   RowBox[{"vi_", ",", "dv_", ",", "ndv_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "c", ",", "Rmatdv", ",", "tmInt", ",", "tmRdv"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Rmatdv", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tmInt", "=", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tmRdv", "=", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"a", "=", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"c", "=", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", 
        RowBox[{"Length", "[", "Rmat", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"tmInt", "=", 
         RowBox[{"LIntpl1D", "[", 
          RowBox[{"vmlist", ",", 
           RowBox[{"Rmat", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tmRdv", "=", 
         RowBox[{
          RowBox[{"SampleInt", "[", "tmInt", "]"}], "[", 
          RowBox[{"vi", ",", "dv", ",", "ndv"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"Rmatdv", ",", "tmRdv"}], "]"}]}]}], "\[IndentingNewLine]", 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"a", "==", "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"c", "=", 
         RowBox[{"c", "+", "1"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"a", "=", 
         RowBox[{"Rmatdv", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "c"}], "]"}], "]"}]}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"c", "-", "1"}], ")"}], "\"\<columns dropped\>\""}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Drop", "[", 
      RowBox[{"Rmatdv", ",", "None", ",", 
       RowBox[{"c", "-", "1"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Code",
 CellChangeTimes->{3.964755974066223*^9},
 CellLabel->
  "In[140]:=",ExpressionUUID->"bf842d77-e7ed-c54d-b904-b3600d0a5435"],

